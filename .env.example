# ─────────────────────────────────────────────────────────────────────────────
# 242-CAISSE Configuration d'environnement
# Copiez ce fichier en .env et renseignez les valeurs.
# .env ne doit JAMAIS être versionné (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Environnement : local | production
APP_ENV=local

# ─── Base de données locale ───────────────────────────────────────────────────
# Chemin vers le fichier SQLite de la boutique.
# Laisser vide pour utiliser le chemin par défaut : database/caisse.db
DB_PATH=

# ─── Synchronisation (Phase 4  non implémentée) ─────────────────────────────
# URL de l'API centrale (serveur Laravel) recevant les données synchronisées.
SYNC_API_URL=

# Clé d'API pour l'authentification auprès du serveur central.
SYNC_API_KEY=
